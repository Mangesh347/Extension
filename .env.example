# Server Configuration
PORT=3000

# Paddle Environment
# Set to 'production' for live payments or 'sandbox' for test mode
PADDLE_ENVIRONMENT=production

# Paddle Live Client-Side Token (Safe for frontend, starts with live_ in production)
PADDLE_CLIENT_TOKEN=live_...

# Paddle Live Webhook Notification Signing Secret (Server-side ONLY, starts with pdl_ntfset_)
PADDLE_WEBHOOK_SECRET_KEY=pdl_ntfset_...

# Paddle Live API Key (Server-side ONLY, optional)
PADDLE_API_KEY=

# Paddle Live Catalog Price IDs
PADDLE_PRICE_PRO_MONTHLY=pri_01m0sskxpygen4qnfq5vsevctm
PADDLE_PRICE_PRO_YEARLY=pri_01m0ssnec6agk7zhrxeze2631x
PADDLE_PRICE_LIFETIME=pri_01m0ssrmz50g4sdnw23v6p0rm6
