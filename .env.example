# Claude Enhancer / Fenwick Labs — Vercel env
# Keep BOTH test + live keys. Flip only PAYMENT_TEST_MODE.

# ── MASTER SWITCH ─────────────────────────────────────────────────────────────
# Live money requires BOTH flags:
#   ALLOW_LIVE_PAYMENTS=true  AND  PAYMENT_TEST_MODE=false
# Otherwise everything stays in TEST (PayPal sandbox + rzp_test_*).
PAYMENT_TEST_MODE=true
ALLOW_LIVE_PAYMENTS=false

# Allow simulated checkout when keys for the active mode are missing
ALLOW_SIMULATED_CHECKOUT=true

# ── PayPal TEST (sandbox) ─────────────────────────────────────────────────────
PAYPAL_TEST_CLIENT_ID=
PAYPAL_TEST_CLIENT_SECRET=

# ── PayPal LIVE ───────────────────────────────────────────────────────────────
PAYPAL_LIVE_CLIENT_ID=
PAYPAL_LIVE_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# ── Razorpay TEST ─────────────────────────────────────────────────────────────
RAZORPAY_TEST_KEY_ID=rzp_test_
RAZORPAY_TEST_KEY_SECRET=

# ── Razorpay LIVE ─────────────────────────────────────────────────────────────
RAZORPAY_LIVE_KEY_ID=rzp_live_
RAZORPAY_LIVE_KEY_SECRET=

# ── Entitlement / email ──────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ENTITLEMENT_SECRET=
RESEND_API_KEY=
MAIL_FROM=Claude Enhancer <billing@fenwicklabs.com>
CRON_SECRET=
INR_USD_RATE=95.12
